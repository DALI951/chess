# SHATRANGI - Apache config for the chess app.
#
# The shared host runs ~25 projects out of one account, so everything here is
# scoped to this directory. Nothing global, no rewrite into a parent.

# --- Stockfish ---------------------------------------------------------------
# The engine is WebAssembly. Without this the browser gets it as
# application/octet-stream and WebAssembly.instantiateStreaming refuses to
# compile it, which shows up as "the engine could not start" and nothing else.
AddType application/wasm .wasm

<IfModule mod_headers.c>
    # 640KB of immutable engine: the only thing on this site worth caching hard.
    <FilesMatch "\.(wasm|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # The app is same-origin only and loads no third-party anything. Saying so in
    # a header means a future dependency cannot quietly widen this by accident.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# --- default document --------------------------------------------------------
# index.html, not index.php: there is no front controller in this project, and
# listing one here first meant every request tried a file that does not exist
# before falling through. Harmless, but it is a lie in the config.
DirectoryIndex index.html

# NOTE: there is deliberately NO rewrite of unknown paths to a front controller.
# An earlier version had `RewriteRule ^ index.php [QSA,L]` with a comment about
# /game/AB12CD challenge links - but there is no index.php, so every mistyped URL
# became a 404 for a file that was never going to exist. Challenge links are a
# URL FRAGMENT (#g=AB12CD) instead, which the browser keeps to itself and the
# client reads on load. The server never sees it, so nothing needs to route it.

# --- never serve the plumbing -------------------------------------------------
# config.local.php holds the database password and lives only on this PC and on
# the server. If a stray .htaccess or a server misconfiguration ever exposes the
# directory, these four lines are the difference between a leak and a 403.
<FilesMatch "^(config\.local\.php|config\.example\.php|README\.md|STATUS\.md|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# The schema installer is token-guarded, and it is denied at the web server as
# well, so a bug in the token check is not the only thing between the internet
# and the schema. The name has to match the file: this used to say install.php,
# which is not a file that exists, so the installer was reachable by anyone who
# guessed the URL - the exact lock this block exists to provide.
<FilesMatch "^(setup\.php)$">
    Require all denied
</FilesMatch>
