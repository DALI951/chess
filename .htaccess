# SHATRANGI - Apache config for the chess app.
#
# The shared host runs ~25 projects out of one account, so everything here is
# scoped to this directory. Nothing global, no rewrite into a parent.

# --- Stockfish ---------------------------------------------------------------
# The engine is WebAssembly. Without this the browser gets it as
# application/octet-stream and WebAssembly.instantiateStreaming refuses to
# compile it, which shows up as "the engine could not start" and nothing else.
AddType application/wasm .wasm

<IfModule mod_headers.c>
    # --- caching, and the bug this comment exists to prevent -------------------
    # This used to be:
    #     <FilesMatch "\.(wasm|js)$">
    #       Header set Cache-Control "public, max-age=31536000, immutable"
    #
    # One year, never revalidate. That is a fine policy for a file whose URL
    # changes when its contents do - a content-hashed bundle - and a disaster
    # for one whose URL never changes. These filenames are stable: index.html
    # asked for "assets/js/app.js" and got it, and asked again tomorrow and got
    # the same URL, so a browser that visited once kept the first app.js it ever
    # downloaded and never asked again.
    #
    # The result was a site where the code on the server was correct and the code
    # in the browser was months old, and nothing anywhere said so. A broken
    # promotion picker, dead quick-play and share buttons, and an online game
    # that did not work - all of it deployed correctly, all of it invisible to
    # anyone whose browser had the site open before the fix.
    #
    # So: revalidate. ETag and Last-Modified are both sent already (they are in
    # the headers above this comment, being the Apache defaults), so an unchanged
    # file costs one small 304 and no bytes at all. That is cheap enough to stop
    # optimising away, and it is the difference between "you are looking at
    # yesterday's site" and "you are looking at this one".
    #
    # scripts/deploy.py additionally stamps ?v=<content hash> into index.html, so
    # a changed bundle also gets a brand-new URL. Two mechanisms, deliberately:
    # the stamp covers index.html's own references, and revalidation covers the
    # relative imports inside app.js, which do NOT inherit the query string.
    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # CSS gets the same treatment for the same reason.
    <FilesMatch "\.css$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # The engine is 640KB, so it is worth serving without a round trip. Still
    # revalidating rather than immutable: a 304 costs nothing, and an immutable
    # engine file is the same year-old trap in a much heavier disguise.
    <FilesMatch "\.wasm$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(png|svg|woff2?)$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>

    # The app is same-origin only and loads no third-party anything. Saying so in
    # a header means a future dependency cannot quietly widen this by accident.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# --- default document --------------------------------------------------------
# index.html, not index.php: there is no front controller in this project, and
# listing one here first meant every request tried a file that does not exist
# before falling through. Harmless, but it is a lie in the config.
DirectoryIndex index.html

# NOTE: there is deliberately NO rewrite of unknown paths to a front controller.
# An earlier version had `RewriteRule ^ index.php [QSA,L]` with a comment about
# /game/AB12CD challenge links - but there is no index.php, so every mistyped URL
# became a 404 for a file that was never going to exist. Challenge links are a
# URL FRAGMENT (#g=AB12CD) instead, which the browser keeps to itself and the
# client reads on load. The server never sees it, so nothing needs to route it.

# --- never serve the plumbing -------------------------------------------------
# .env holds the database password and lives only on this PC and on the server.
# It is the most dangerous filename on the site: it is PLAIN TEXT, so unlike
# config.local.php there is no PHP handler between a request and the password.
# The deny below is the only thing standing between the internet and it.
#
# /\.env$ also covers .env.example and any .env.local, deliberately: an example
# file is harmless today, and a pattern that only matches the exact current name
# is one rename away from leaking the real one.
<FilesMatch "(^|/)\.env(\.|$)">
    Require all denied
</FilesMatch>

# config.local.php is the OLDER format, still supported so an existing
# deployment keeps booting, and still denied for the same reason.
<FilesMatch "^(config\.local\.php|config\.example\.php|README\.md|STATUS\.md|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# The schema installer is token-guarded, and it is denied at the web server as
# well, so a bug in the token check is not the only thing between the internet
# and the schema. The name has to match the file: this used to say install.php,
# which is not a file that exists, so the installer was reachable by anyone who
# guessed the URL - the exact lock this block exists to provide.
<FilesMatch "^(setup\.php)$">
    Require all denied
</FilesMatch>
