# SHATRANGI - settings template. Copy to .env and fill in the values.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit the filled-in copy.
#
# Formatting rules, and why they exist:
#   * Quote any value with a space, a # or a quote character in it. Quote a
#     password ALWAYS - a generated password very often ends in "#", and an
#     unquoted value would be truncated there by the comment rule.
#   * An inline comment needs a space before the #: "KEY=value  # note" is a
#     comment, "KEY=va#lue" is not.
#   * No trailing slash on CHESS_SITE_ORIGIN.

# --- database ----------------------------------------------------------------
CHESS_DB_HOST=localhost
CHESS_DB_PORT=3306
CHESS_DB_NAME=
CHESS_DB_USER=
CHESS_DB_PASS=
CHESS_DB_CHARSET=utf8mb4

# --- site --------------------------------------------------------------------
CHESS_SITE_NAME=shatrangi
CHESS_SITE_ORIGIN=https://example.com/chess

# --- session -----------------------------------------------------------------
# HTTPS-only session cookie. false only for plain http on localhost.
CHESS_COOKIE_SECURE=true

# --- setup -------------------------------------------------------------------
# Second lock on api/setup.php (the web server denies that file too).
# Generate your own: python -c "import secrets;print(secrets.token_hex(16))"
CHESS_SETUP_TOKEN=
