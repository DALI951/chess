{
  "name": "chess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chess — play vs Stockfish and vs humans online. Arabic + English.",
  "author": "DALI951",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/js/*.test.mjs\"",
    "test:deep": "node tools/deep-test.mjs \"tests/js/*.test.mjs\"",
    "test:php": "node tools/run-php.mjs",
    "test:php:quick": "node tools/run-php.mjs --quick",
    "test:ui": "node tools/smoke.mjs",
    "test:ui:shots": "node tools/smoke.mjs --shots",
    "test:visual": "node tools/visual-check.mjs",
    "test:design": "node tools/design-audit.mjs",
    "test:gate": "node tools/gate-flash.mjs",
    "test:art": "node tools/piece-preview.mjs",
    "test:all": "npm test && npm run test:php:quick",
    "test:everything": "npm test && npm run test:php:quick && npm run test:art && npm run test:ui && npm run test:visual && npm run test:design && npm run test:gate",
    "fixtures:check": "node tools/gen-move-fixtures.mjs --check",
    "fixtures:gen": "node tools/gen-move-fixtures.mjs",
    "serve:php": "node tools/serve.mjs",
    "perft": "node --test tests/js/perft.test.mjs",
    "perft:divide": "node tools/perft-divide.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "stockfish.js": "^10.0.2"
  }
}
